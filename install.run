#!/usr/bin/env bash
# =============================================================================
# TorFiles - Script de Instalação Universal via Docker
# Compatível: Debian, Ubuntu, RHEL/Fedora/CentOS, Arch e derivados
# =============================================================================

set -euo pipefail

# Cores para output (escape real para funcionar com echo -e e printf)
ESC=$'\033'
RED="${ESC}[0;31m"
GREEN="${ESC}[0;32m"
YELLOW="${ESC}[1;33m"
BLUE="${ESC}[0;34m"
CYAN="${ESC}[0;36m"
PURPLE="${ESC}[0;35m"
BOLD="${ESC}[1m"
DIM="${ESC}[2m"
NC="${ESC}[0m" # No Color

# Funções de log (vão para stderr para não poluir capturas de saída)
log_info() { echo -e "${BLUE}[INFO]${NC} $*" >&2; }
log_ok() { echo -e "${GREEN}[OK]${NC} $*" >&2; }
log_warn() { echo -e "${YELLOW}[AVISO]${NC} $*" >&2; }
log_err() { echo -e "${RED}[ERRO]${NC} $*" >&2; }
log_step() { echo -e "\n${CYAN}==== $* ====${NC}\n" >&2; }

# ---------------------------------------------------------------------------
# Banner com degradê (truecolor ANSI 24-bit)
# ---------------------------------------------------------------------------

# Quantizacao do degradê (numero de tons usados)
GRADIENT_STEPS=48

# Interpola entre duas cores RGB -> sequencia ANSI
ramp_color() {
    local pct="$1" r1="$2" g1="$3" b1="$4" r2="$5" g2="$6" b2="$7"
    local r g b
    r=$(( r1 + (r2 - r1) * pct / 100 ))
    g=$(( g1 + (g2 - g1) * pct / 100 ))
    b=$(( b1 + (b2 - b1) * pct / 100 ))
    printf '%s[38;2;%d;%d;%dm' "${ESC}" "${r}" "${g}" "${b}"
}

# Define a cor (pct 0..100) na rampa: ciano -> azul -> roxo Tor
gradient_color() {
    local pct="$1"
    if [[ ${pct} -le 50 ]]; then
        ramp_color $(( pct * 2 )) 6 182 212 59 130 246
    else
        ramp_color $(( (pct - 50) * 2 )) 59 130 246 125 70 152
    fi
}

# Imprime texto com degradê contínuo por caractere
render_gradient() {
    local text="$1"
    local total=0
    local line
    local idx=0
    local j ch color out prev_color=""

    while IFS= read -r line; do
        total=$(( total + ${#line} + 1 ))
    done <<< "${text}"

    while IFS= read -r line; do
        out=""
        for (( j = 0; j < ${#line}; j++ )); do
            ch="${line:j:1}"
            if [[ -n "${ch// /}" ]]; then
                # Quantiza a posicao em GRADIENT_STEPS tons p/ reduzir escapes repetidos
                local step=$(( idx * GRADIENT_STEPS / (total > 0 ? total : 1) ))
                color=$(gradient_color $(( step * 100 / GRADIENT_STEPS )))
                if [[ "${color}" != "${prev_color}" ]]; then
                    out+="${color}"
                    prev_color="${color}"
                fi
                out+="${ch}"
            else
                out+="${ch}"
            fi
            idx=$(( idx + 1 ))
        done
        # NC reinicia tudo; BOLD e reaplicado para manter o destaque
        printf '%s%s%s\n' "${out}" "${NC}" "${BOLD}"
    done <<< "${text}"
}

# Banner
show_banner() {
    local art
    art=$(cat <<'BANNER'
█████  ███  ████  █████ ███ █     █████  ████   
 ░█░░░█ ░░█ █░░░█ █░░░░░ █░░█░    █░░░░░█ ░░░░  
  █░░░█░ ░█░████░░████░░░█░░█░░   ████░░░███░░░ 
  █░░ █░░ █░█░░█░ █░░░░  █░░█░░   █░░░░   ░░█   
  █░░  ███ ░█░░░█░█░░░░░███░█████ █████░████░░  
   ░░   ░░░ ░░░  ░ ░░    ░░░ ░░░░░ ░░░░░ ░░░░ ░ 
    ░    ░░░  ░   ░ ░     ░░░ ░░░░░ ░░░░░ ░░░░  
BANNER
)

    printf '%s' "${BOLD}"
    render_gradient "${art}"

    echo
    printf '     %s%s%s\n' "${BOLD}${CYAN}" "TorFiles - Instalação Universal via Docker" "${NC}"
    printf '   %sSistema Seguro de Compartilhamento de Arquivos%s\n' "${DIM}" "${NC}"
    echo
}

# Verifica se é root
check_root() {
    if [[ $EUID -ne 0 ]]; then
        log_err "Este script precisa ser executado como root (use sudo)"
        exit 1
    fi
}

# Detecta distribuição
detect_distro() {
    if [[ -f /etc/os-release ]]; then
        # shellcheck source=/dev/null
        . /etc/os-release
        # Nem todo os-release define todas as variáveis (ex: Arch não define ID_LIKE).
        # O script roda com 'set -u', então usamos defaults vazios para evitar abortar.
        DISTRO_ID="${ID:-unknown}"
        DISTRO_LIKE="${ID_LIKE:-}"
        DISTRO_VERSION="${VERSION_ID:-}"
        DISTRO_NAME="${PRETTY_NAME:-${DISTRO_ID}}"
    else
        log_err "Não foi possível detectar a distribuição (/etc/os-release não encontrado)"
        exit 1
    fi

    case "${DISTRO_ID}" in
        debian|ubuntu|linuxmint|pop|elementary|zorin|kali|parrot|devuan|mx|linuxmintdebian)
            PKG_MGR="apt"
            DISTRO_FAMILY="debian"
            INSTALL_CMD="apt-get install -y -qq"
            UPDATE_CMD="apt-get update -qq"
            DOCKER_PKGS=("docker-ce" "docker-ce-cli" "containerd.io" "docker-buildx-plugin" "docker-compose-plugin")
            ;;
        fedora|rhel|centos|rocky|almalinux|ol|oracle|nobara|ultramarine)
            PKG_MGR="dnf"
            DISTRO_FAMILY="rhel"
            INSTALL_CMD="dnf install -y -q"
            UPDATE_CMD="dnf check-update -q || true"
            DOCKER_PKGS=("docker-ce" "docker-ce-cli" "containerd.io" "docker-buildx-plugin" "docker-compose-plugin")
            ;;
        arch|manjaro|endeavouros|garuda|cachyos|artix|archarm)
            PKG_MGR="pacman"
            DISTRO_FAMILY="arch"
            INSTALL_CMD="pacman -S --noconfirm --needed"
            UPDATE_CMD="pacman -Sy --noconfirm"
            DOCKER_PKGS=("docker" "docker-compose")
            ;;
        opensuse*|sles|sled)
            PKG_MGR="zypper"
            DISTRO_FAMILY="suse"
            INSTALL_CMD="zypper install -y -q"
            UPDATE_CMD="zypper refresh -q"
            DOCKER_PKGS=("docker" "docker-compose")
            ;;
        *)
            # Fallback: tenta classificar pelo ID_LIKE (ex: "ubuntu" deriving de "debian")
            local like
            for like in ${DISTRO_LIKE//,/ }; do
                case "${like}" in
                    debian|ubuntu)
                        PKG_MGR="apt"
                        DISTRO_FAMILY="debian"
                        INSTALL_CMD="apt-get install -y -qq"
                        UPDATE_CMD="apt-get update -qq"
                        DOCKER_PKGS=("docker-ce" "docker-ce-cli" "containerd.io" "docker-buildx-plugin" "docker-compose-plugin")
                        break
                        ;;
                    fedora|rhel|centos)
                        PKG_MGR="dnf"
                        DISTRO_FAMILY="rhel"
                        INSTALL_CMD="dnf install -y -q"
                        UPDATE_CMD="dnf check-update -q || true"
                        DOCKER_PKGS=("docker-ce" "docker-ce-cli" "containerd.io" "docker-buildx-plugin" "docker-compose-plugin")
                        break
                        ;;
                    arch|manjaro)
                        PKG_MGR="pacman"
                        DISTRO_FAMILY="arch"
                        INSTALL_CMD="pacman -S --noconfirm --needed"
                        UPDATE_CMD="pacman -Sy --noconfirm"
                        DOCKER_PKGS=("docker" "docker-compose")
                        break
                        ;;
                    opensuse|suse)
                        PKG_MGR="zypper"
                        DISTRO_FAMILY="suse"
                        INSTALL_CMD="zypper install -y -q"
                        UPDATE_CMD="zypper refresh -q"
                        DOCKER_PKGS=("docker" "docker-compose")
                        break
                        ;;
                esac
            done

            if [[ -z "${PKG_MGR:-}" ]]; then
                log_err "Distribuição não suportada: ${DISTRO_NAME} (ID=${DISTRO_ID})"
                log_err "ID_LIKE: ${DISTRO_LIKE:-<vazio>}"
                log_err "Distribuições suportadas: Debian/Ubuntu, RHEL/Fedora, Arch e openSUSE"
                exit 1
            fi
            ;;
    esac

    log_ok "Distribuição detectada: ${DISTRO_NAME} (${DISTRO_ID})"
    log_ok "Família: ${DISTRO_FAMILY} | Gerenciador: ${PKG_MGR}"
}

# Verifica se comando existe
cmd_exists() { command -v "$1" >/dev/null 2>&1; }

# Atualiza cache de pacotes
update_package_cache() {
    log_info "Atualizando cache de pacotes..."
    eval "${UPDATE_CMD}"
}

# Instala pacotes
install_packages() {
    local pkgs=("$@")
    log_info "Instalando: ${pkgs[*]}"
    eval "${INSTALL_CMD} ${pkgs[*]}"
}

# Instala Docker
install_docker() {
    log_step "Instalando Docker"

    if cmd_exists docker && docker info >/dev/null 2>&1; then
        log_ok "Docker já instalado e funcionando"
        return 0
    fi

    case "${DISTRO_FAMILY}" in
        debian)
            # Remove versões antigas
            apt-get remove -y -qq docker.io docker-doc docker-compose docker-compose-v2 podman-docker containerd runc 2>/dev/null || true

            # Dependências
            install_packages ca-certificates curl gnupg lsb-release

            # Repositório oficial Docker
            install -m 0755 -d /etc/apt/keyrings
            local docker_gpg_key="/etc/apt/keyrings/docker.gpg"
            if [[ ! -f "${docker_gpg_key}" ]]; then
                curl -fsSL "https://download.docker.com/linux/${DISTRO_ID}/gpg" | gpg --dearmor -o "${docker_gpg_key}"
                chmod a+r "${docker_gpg_key}"
            fi

            local docker_repo="/etc/apt/sources.list.d/docker.list"
            echo "deb [arch=$(dpkg --print-architecture) signed-by=${docker_gpg_key}] https://download.docker.com/linux/${DISTRO_ID} $(lsb_release -cs) stable" > "${docker_repo}"

            update_package_cache
            install_packages "${DOCKER_PKGS[@]}"
            ;;

        rhel)
            # Remove versões antigas
            dnf remove -y -q docker docker-client docker-client-latest docker-common docker-latest docker-latest-logrotate docker-logrotate docker-engine podman runc 2>/dev/null || true

            # Dependências
            install_packages dnf-plugins-core

            # Repositório oficial Docker (usa centos para RHEL-based)
            dnf config-manager --add-repo https://download.docker.com/linux/centos/docker-ce.repo

            update_package_cache
            install_packages "${DOCKER_PKGS[@]}"
            ;;

        arch)
            install_packages "${DOCKER_PKGS[@]}"
            ;;

        suse)
            install_packages "${DOCKER_PKGS[@]}"
            ;;
    esac

    # Inicia e habilita serviço
    systemctl enable --now docker
    log_ok "Docker instalado e serviço iniciado"
}

# Verifica/garante Docker Compose
ensure_docker_compose() {
    log_step "Verificando Docker Compose"

    if docker compose version >/dev/null 2>&1; then
        COMPOSE_CMD="docker compose"
        log_ok "Docker Compose (plugin) disponível: $(docker compose version --short)"
        return 0
    fi

    if cmd_exists docker-compose; then
        COMPOSE_CMD="docker-compose"
        log_ok "Docker Compose (standalone) disponível: $(docker-compose version --short)"
        return 0
    fi

    log_info "Docker Compose não encontrado, instalando..."

    case "${DISTRO_FAMILY}" in
        debian|rhel)
            install_packages docker-compose-plugin
            ;;
        arch|suse)
            install_packages docker-compose
            ;;
    esac

    if docker compose version >/dev/null 2>&1; then
        COMPOSE_CMD="docker compose"
    elif cmd_exists docker-compose; then
        COMPOSE_CMD="docker-compose"
    else
        log_err "Falha ao instalar Docker Compose"
        exit 1
    fi
    log_ok "Docker Compose configurado: ${COMPOSE_CMD}"
}

# Gera senha aleatória segura
gen_password() {
    # 32 caracteres: alfanumérico + símbolos seguros
    # NOTA: 'head -c 32' fecha o pipe antes do 'tr' terminar, o que gera SIGPIPE (exit 141).
    # Com 'set -e' + 'pipefail' isso abortava o instalador silenciosamente.
    # Solução: gera um bloco grande de bytes e filtra com 'tr' (sem pipe para 'head').
    local raw
    raw=$(head -c 512 /dev/urandom | LC_ALL=C tr -dc 'A-Za-z0-9!@#$%^&*()_+-=')
    printf '%s' "${raw:0:32}"
}

# Gera chave de criptografia base64 (32 bytes = 44 chars base64)
gen_encryption_key() {
    openssl rand -base64 32
}

# Prepara arquivo .env
prepare_env_file() {
    local project_dir="$1"
    local env_file="${project_dir}/.env"

    log_step "Preparando arquivo .env"

    cd "${project_dir}"

    if [[ -f "${env_file}" ]]; then
        log_warn "Arquivo .env já existe, fazendo backup..."
        cp "${env_file}" "${env_file}.backup.$(date +%s)"
    fi

    # Gera todas as chaves/senhas
    local secret_key
    local encryption_key
    local mariadb_root_password
    local mariadb_password
    local postgres_password

    secret_key=$(openssl rand -hex 32)
    encryption_key=$(gen_encryption_key)
    mariadb_root_password=$(gen_password)
    mariadb_password=$(gen_password)
    postgres_password=$(gen_password)

    log_info "Gerando credenciais seguras..."

    cat > "${env_file}" <<EOF
# =============================================================================
# TorFiles - Configuração gerada automaticamente pelo install.run
# $(date)
# =============================================================================

# Chaves de segurança da aplicação (NÃO PERCA ESTAS CHAVES!)
SECRET_KEY=${secret_key}
ENCRYPTION_KEY=${encryption_key}

# Senhas dos bancos de dados (geradas aleatoriamente)
MARIADB_ROOT_PASSWORD=${mariadb_root_password}
MARIADB_PASSWORD=${mariadb_password}
POSTGRES_PASSWORD=${postgres_password}

# Configurações opcionais
DOCS_ENABLED=true

# =============================================================================
# IMPORTANTE: Guarde este arquivo com segurança!
# - SECRET_KEY: Necessária para sessões Flask (perda = usuários deslogados)
# - ENCRYPTION_KEY: Necessária para descriptografar arquivos (PERDA = DADOS PERDIDOS!)
# - Senhas dos bancos: Para backup/restore manual se necessário
# =============================================================================
EOF

    chmod 600 "${env_file}"
    log_ok "Arquivo .env criado em ${env_file} (permissões 600)"
    log_warn "⚠️  BACKUP OBRIGATÓRIO: Copie este arquivo para local seguro!"
    log_warn "   Perda da ENCRYPTION_KEY = PERDA TOTAL DOS ARQUIVOS CRIPTOGRAFADOS!"

    # Mostra resumo (sem mostrar as chaves completas por segurança)
    echo
    echo "  Credenciais geradas:"
    echo "  ────────────────────────────────────────────────────────────────"
    printf "  SECRET_KEY:           %s...%s\n" "${secret_key:0:8}" "${secret_key: -8}"
    printf "  ENCRYPTION_KEY:       %s...%s\n" "${encryption_key:0:12}" "${encryption_key: -12}"
    printf "  MARIADB_ROOT_PASSWORD: %s\n" "${mariadb_root_password}"
    printf "  MARIADB_PASSWORD:      %s\n" "${mariadb_password}"
    printf "  POSTGRES_PASSWORD:     %s\n" "${postgres_password}"
    echo "  ────────────────────────────────────────────────────────────────"
}

# Build da imagem Docker
build_docker_image() {
    local project_dir="$1"

    log_step "Construindo imagem Docker do TorFiles"

    cd "${project_dir}"

    log_info "Executando docker build..."
    docker build -t torfiles:latest .

    log_ok "Imagem torfiles:latest criada com sucesso"
}

# Sobe os containers
start_containers() {
    local project_dir="$1"

    log_step "Iniciando containers"

    cd "${project_dir}"

    log_info "Subindo stack com ${COMPOSE_CMD}..."
    ${COMPOSE_CMD} up -d

    log_ok "Containers iniciados"

    # Aguarda healthchecks
    log_info "Aguardando health checks dos bancos de dados..."
    local max_wait=120
    local waited=0
    local interval=5

    while [[ ${waited} -lt ${max_wait} ]]; do
        local mariadb_health
        local postgres_health

        mariadb_health=$(docker inspect --format='{{.State.Health.Status}}' torfiles-mariadb 2>/dev/null || echo "unknown")
        postgres_health=$(docker inspect --format='{{.State.Health.Status}}' torfiles-postgres 2>/dev/null || echo "unknown")

        if [[ "${mariadb_health}" == "healthy" && "${postgres_health}" == "healthy" ]]; then
            log_ok "Todos os bancos de dados estão saudáveis"
            break
        fi

        sleep ${interval}
        waited=$((waited + interval))
        echo -n "."
    done
    echo

    if [[ ${waited} -ge ${max_wait} ]]; then
        log_warn "Timeout aguardando health checks. Verifique com: ${COMPOSE_CMD} logs"
    fi
}

# Verifica se a aplicação está respondendo
verify_app() {
    local project_dir="$1"

    log_step "Verificando aplicação"

    cd "${project_dir}"

    local max_wait=60
    local waited=0
    local interval=3

    while [[ ${waited} -lt ${max_wait} ]]; do
        if curl -sf http://localhost:8000 >/dev/null 2>&1; then
            log_ok "Aplicação respondendo em http://localhost:8000"
            return 0
        fi
        sleep ${interval}
        waited=$((waited + interval))
        echo -n "."
    done
    echo

    log_warn "Aplicação pode não estar pronta ainda. Verifique logs com: ${COMPOSE_CMD} logs -f app"
}

# Mostra resumo final
show_summary() {
    local project_dir="$1"

    cat <<EOF

╔══════════════════════════════════════════════════════════════════════════════╗
║                         INSTALAÇÃO CONCLUÍDA!                                ║
╚══════════════════════════════════════════════════════════════════════════════╝

📁 Diretório do projeto: ${project_dir}
🌐 Aplicação: http://localhost:8000
📄 Documentação: http://localhost:8000/docs (se DOCS_ENABLED=true)

📦 Containers:
   • torfiles-web      - Aplicação Flask (porta 8000)
   • torfiles-mariadb  - MariaDB (metadados/usuários)
   • torfiles-postgres - PostgreSQL (arquivos criptografados)

🔧 Comandos úteis:
   Ver logs:                ${COMPOSE_CMD} logs -f
   Ver logs app:            ${COMPOSE_CMD} logs -f app
   Parar tudo:              ${COMPOSE_CMD} down
   Parar + remover volumes: ${COMPOSE_CMD} down -v  ⚠️ APAGA DADOS!
   Reiniciar:               ${COMPOSE_CMD} restart
   Atualizar app:           cd ${project_dir} && docker build -t torfiles:latest . && ${COMPOSE_CMD} up -d

⚠️  BACKUP CRÍTICO - GUARDE ESTES ARQUIVOS EM LOCAL SEGURO:
   ${project_dir}/.env  (contém TODAS as chaves e senhas)

   PERDA DA ENCRYPTION_KEY == PERDA TOTAL E IRREVERSÍVEL DOS ARQUIVOS!

📖 Próximos passos recomendados:
   1. Faça backup do arquivo .env EM LOCAL SEGURO
   2. Configure proxy reverso (Nginx) + HTTPS (Certbot) para produção
   3. Para Tor Hidden Service: veja docs/deployment.md
   4. Configure backups automáticos dos bancos (MariaDB + PostgreSQL)

EOF
}

# ---------------------------------------------------------------------------
# Resolução do diretório do projeto / clone automático
# ---------------------------------------------------------------------------

# Repositório oficial do TorFiles
REPO_URL="https://github.com/MrDiogoMilhomem/TorFiles.git"
REPO_BRANCH="main"

# Arquivos essenciais para o build
REQUIRED_FILES=("Dockerfile" "docker-compose.yml" "app.py")

# Verifica se um diretório contém os arquivos essenciais do projeto
has_project_files() {
    local dir="$1"
    local f
    for f in "${REQUIRED_FILES[@]}"; do
        if [[ ! -f "${dir}/${f}" ]]; then
            return 1
        fi
    done
    return 0
}

# Retorna o diretório de trabalho atual, ou "/" se não for determinável
current_dir() {
    pwd 2>/dev/null || echo "/"
}

# Instala o git se necessário (necessário para clonar o repositório)
ensure_git() {
    if cmd_exists git; then
        return 0
    fi

    log_info "Git não encontrado, instalando..."
    case "${DISTRO_FAMILY}" in
        debian) apt-get install -y -qq git ;;
        rhel)   dnf install -y -q git ;;
        arch)   pacman -S --noconfirm --needed git ;;
        suse)   zypper install -y -q git ;;
        *)      log_err "Não foi possível instalar o git automaticamente"; exit 1 ;;
    esac

    if ! cmd_exists git; then
        log_err "Instalação do git falhou"
        exit 1
    fi
}

# Clona (ou atualiza) o repositório do TorFiles no destino
clone_repo() {
    local dest="$1"

    ensure_git

    if [[ -d "${dest}/.git" ]]; then
        log_info "Repositório já existe em ${dest}, atualizando..."
        git -C "${dest}" fetch --depth 1 origin "${REPO_BRANCH}" 2>/dev/null \
            || git -C "${dest}" fetch origin
        git -C "${dest}" checkout "${REPO_BRANCH}" 2>/dev/null || true
        git -C "${dest}" pull --ff-only 2>/dev/null || true
        log_ok "Repositório atualizado"
        return 0
    fi

    log_info "Baixando o TorFiles de ${REPO_URL}..."
    rm -rf "${dest}"
    mkdir -p "$(dirname "${dest}")"

    # O output do git vai para stderr para não contaminar a captura do diretório
    if ! git clone --depth 1 --branch "${REPO_BRANCH}" "${REPO_URL}" "${dest}" >&2; then
        log_err "Falha ao clonar o repositório"
        log_err "Verifique a conexão com a internet ou clone manualmente:"
        log_err "  git clone ${REPO_URL} ${dest}"
        exit 1
    fi

    log_ok "Repositório baixado para ${dest}"
}

# Descobre/garante o diretório do projeto com os arquivos necessários.
# Se o script foi executado via "curl ... | sudo bash", não há BASH_SOURCE,
# então procuramos os arquivos no diretório atual ou clonamos o repositório.
resolve_project_dir() {
    local script_dir=""
    local candidate=""

    # 1) Script executado como arquivo (./install.run ou bash install.run)
    if [[ -n "${BASH_SOURCE[0]:-}" ]] && [[ "${BASH_SOURCE[0]}" != "-" ]]; then
        script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
        if has_project_files "${script_dir}"; then
            log_ok "Projeto encontrado em ${script_dir}"
            echo "${script_dir}"
            return 0
        fi
    fi

    # 2) Diretório atual do usuário (comando pipe: curl ... | sudo bash)
    candidate="$(current_dir)"
    if has_project_files "${candidate}"; then
        log_ok "Projeto encontrado em ${candidate}"
        echo "${candidate}"
        return 0
    fi

    # 3) Locais comuns
    for candidate in /opt/torfiles /opt/TorFiles "${HOME:-/root}/TorFiles" "${HOME:-/root}/torfiles"; do
        if has_project_files "${candidate}"; then
            log_ok "Projeto encontrado em ${candidate}"
            echo "${candidate}"
            return 0
        fi
    done

    # 4) Não achou: clona o repositório
    local target="${TORFILES_DIR:-/opt/torfiles}"
    log_warn "Arquivos do projeto não encontrados neste diretório."
    log_info "Baixando o projeto para ${target}..."
    clone_repo "${target}"

    if ! has_project_files "${target}"; then
        log_err "Download concluído mas os arquivos esperados não estão em ${target}"
        log_err "Esperados: ${REQUIRED_FILES[*]}"
        exit 1
    fi

    echo "${target}"
}

# Detecta se o instalador foi baixado como HTML em vez de bash.
# IMPORTANTE: o bash executa o script piped linha a linha, entao uma pagina HTML
# cause "erro de sintaxe" na linha 1 e o script morre ANTES de chegar aqui.
# Por isso esta funcao so checa o cabecalho do proprio arquivo quando executado
# como arquivo; no modo pipe, a protecao real e o clone automatico do projeto.
check_not_html() {
    local self="${BASH_SOURCE[0]:-}"
    local head_line=""

    [[ -z "${self}" || "${self}" == "-" ]] && return 0
    [[ -f "${self}" ]] || return 0

    head_line="$(head -n 1 "${self}" 2>/dev/null || true)"

    if [[ "${head_line}" == *"<!DOCTYPE html"* ]] || [[ "${head_line}" == *"<html"* ]]; then
        log_err "O arquivo recebido é uma página HTML, não o instalador bash."
        log_err "Use a URL 'raw' do GitHub (sem /blob/):"
        log_err "  curl -fsSL https://raw.githubusercontent.com/MrDiogoMilhomem/TorFiles/main/install.run | sudo bash"
        exit 1
    fi
}

# Função principal
main() {
    show_banner
    check_not_html
    check_root
    detect_distro

    # Diretório do projeto (com download automático se necessário)
    local script_dir
    script_dir="$(resolve_project_dir)"

    log_step "Iniciando instalação do TorFiles"

    update_package_cache
    install_docker
    ensure_docker_compose
    prepare_env_file "${script_dir}"
    build_docker_image "${script_dir}"
    start_containers "${script_dir}"
    verify_app "${script_dir}"
    show_summary "${script_dir}"

    log_ok "Instalação finalizada com sucesso!"
}

# Executa
main "$@"