#!/usr/bin/env bash
# =============================================================================
# TorFiles - Script de Instalação Universal via Docker
# Compatível: Debian, Ubuntu, RHEL/Fedora/CentOS, Arch e derivados
# =============================================================================

set -euo pipefail

# Cores para output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Funções de log
log_info() { echo -e "${BLUE}[INFO]${NC} $*"; }
log_ok() { echo -e "${GREEN}[OK]${NC} $*"; }
log_warn() { echo -e "${YELLOW}[AVISO]${NC} $*"; }
log_err() { echo -e "${RED}[ERRO]${NC} $*"; }
log_step() { echo -e "\n${CYAN}==== $* ====${NC}\n"; }

# Banner
show_banner() {
    echo 'EOF'
╔══════════════════════════════════════════════════════════════════════════════╗
║                    TorFiles - Instalação Universal                           ║
║           Sistema Seguro de Compartilhamento de Arquivos                     ║
║                                                                              ║
║   Compatível: Debian/Ubuntu, RHEL/Fedora, Arch/Manjaro/CachyOS, openSUSE     ║
╚══════════════════════════════════════════════════════════════════════════════╝
EOF
}

# Verifica se é root
check_root() {
    if [[ $EUID -ne 0 ]]; then
        log_err "Este script precisa ser executado como root (use sudo)"
        exit 1
    fi
}

# Detecta distribuição
detect_distro() {
    if [[ -f /etc/os-release ]]; then
        # shellcheck source=/dev/null
        . /etc/os-release
        DISTRO_ID="${ID,,}"
        DISTRO_LIKE="${ID_LIKE,,}"
        DISTRO_VERSION="${VERSION_ID}"
        DISTRO_NAME="${PRETTY_NAME}"
    else
        log_err "Não foi possível detectar a distribuição (/etc/os-release não encontrado)"
        exit 1
    fi

    case "${DISTRO_ID}" in
        debian|ubuntu|linuxmint|pop|elementary|zorin|kali|parrot|devuan|mx|linuxmintdebian)
            PKG_MGR="apt"
            DISTRO_FAMILY="debian"
            INSTALL_CMD="apt-get install -y -qq"
            UPDATE_CMD="apt-get update -qq"
            DOCKER_PKGS=("docker-ce" "docker-ce-cli" "containerd.io" "docker-buildx-plugin" "docker-compose-plugin")
            ;;
        fedora|rhel|centos|rocky|almalinux|ol|oracle|nobara|ultramarine)
            PKG_MGR="dnf"
            DISTRO_FAMILY="rhel"
            INSTALL_CMD="dnf install -y -q"
            UPDATE_CMD="dnf check-update -q || true"
            DOCKER_PKGS=("docker-ce" "docker-ce-cli" "containerd.io" "docker-buildx-plugin" "docker-compose-plugin")
            ;;
        arch|manjaro|endeavouros|garuda|cachyos|artix|archarm)
            PKG_MGR="pacman"
            DISTRO_FAMILY="arch"
            INSTALL_CMD="pacman -S --noconfirm --needed"
            UPDATE_CMD="pacman -Sy --noconfirm"
            DOCKER_PKGS=("docker" "docker-compose")
            ;;
        opensuse*|sles|sled)
            PKG_MGR="zypper"
            DISTRO_FAMILY="suse"
            INSTALL_CMD="zypper install -y -q"
            UPDATE_CMD="zypper refresh -q"
            DOCKER_PKGS=("docker" "docker-compose")
            ;;
    esac

    log_ok "Distribuição detectada: ${DISTRO_NAME} (${DISTRO_ID})"
    log_ok "Família: ${DISTRO_FAMILY} | Gerenciador: ${PKG_MGR}"
}

# Verifica se comando existe
cmd_exists() { command -v "$1" >/dev/null 2>&1; }

# Atualiza cache de pacotes
update_package_cache() {
    log_info "Atualizando cache de pacotes..."
    eval "${UPDATE_CMD}"
}

# Instala pacotes
install_packages() {
    local pkgs=("$@")
    log_info "Instalando: ${pkgs[*]}"
    eval "${INSTALL_CMD} ${pkgs[*]}"
}

# Instala Docker
install_docker() {
    log_step "Instalando Docker"

    if cmd_exists docker && docker info >/dev/null 2>&1; then
        log_ok "Docker já instalado e funcionando"
        return 0
    fi

    case "${DISTRO_FAMILY}" in
        debian)
            # Remove versões antigas
            apt-get remove -y -qq docker.io docker-doc docker-compose docker-compose-v2 podman-docker containerd runc 2>/dev/null || true

            # Dependências
            install_packages ca-certificates curl gnupg lsb-release

            # Repositório oficial Docker
            install -m 0755 -d /etc/apt/keyrings
            local docker_gpg_key="/etc/apt/keyrings/docker.gpg"
            if [[ ! -f "${docker_gpg_key}" ]]; then
                curl -fsSL "https://download.docker.com/linux/${DISTRO_ID}/gpg" | gpg --dearmor -o "${docker_gpg_key}"
                chmod a+r "${docker_gpg_key}"
            fi

            local docker_repo="/etc/apt/sources.list.d/docker.list"
            echo "deb [arch=$(dpkg --print-architecture) signed-by=${docker_gpg_key}] https://download.docker.com/linux/${DISTRO_ID} $(lsb_release -cs) stable" > "${docker_repo}"

            update_package_cache
            install_packages "${DOCKER_PKGS[@]}"
            ;;

        rhel)
            # Remove versões antigas
            dnf remove -y -q docker docker-client docker-client-latest docker-common docker-latest docker-latest-logrotate docker-logrotate docker-engine podman runc 2>/dev/null || true

            # Dependências
            install_packages dnf-plugins-core

            # Repositório oficial Docker (usa centos para RHEL-based)
            dnf config-manager --add-repo https://download.docker.com/linux/centos/docker-ce.repo

            update_package_cache
            install_packages "${DOCKER_PKGS[@]}"
            ;;

        arch)
            install_packages "${DOCKER_PKGS[@]}"
            ;;

        suse)
            install_packages "${DOCKER_PKGS[@]}"
            ;;
    esac

    # Inicia e habilita serviço
    systemctl enable --now docker
    log_ok "Docker instalado e serviço iniciado"
}

# Verifica/garante Docker Compose
ensure_docker_compose() {
    log_step "Verificando Docker Compose"

    if docker compose version >/dev/null 2>&1; then
        COMPOSE_CMD="docker compose"
        log_ok "Docker Compose (plugin) disponível: $(docker compose version --short)"
        return 0
    fi

    if cmd_exists docker-compose; then
        COMPOSE_CMD="docker-compose"
        log_ok "Docker Compose (standalone) disponível: $(docker-compose version --short)"
        return 0
    fi

    log_info "Docker Compose não encontrado, instalando..."

    case "${DISTRO_FAMILY}" in
        debian|rhel)
            install_packages docker-compose-plugin
            ;;
        arch|suse)
            install_packages docker-compose
            ;;
    esac

    if docker compose version >/dev/null 2>&1; then
        COMPOSE_CMD="docker compose"
    elif cmd_exists docker-compose; then
        COMPOSE_CMD="docker-compose"
    else
        log_err "Falha ao instalar Docker Compose"
        exit 1
    fi
    log_ok "Docker Compose configurado: ${COMPOSE_CMD}"
}

# Gera senha aleatória segura
gen_password() {
    # 32 caracteres: alfanumérico + símbolos seguros
    tr -dc 'A-Za-z0-9!@#$%^&*()_+-=' </dev/urandom | head -c 32
}

# Gera chave de criptografia base64 (32 bytes = 44 chars base64)
gen_encryption_key() {
    openssl rand -base64 32
}

# Prepara arquivo .env
prepare_env_file() {
    local project_dir="$1"
    local env_file="${project_dir}/.env"

    log_step "Preparando arquivo .env"

    cd "${project_dir}"

    if [[ -f "${env_file}" ]]; then
        log_warn "Arquivo .env já existe, fazendo backup..."
        cp "${env_file}" "${env_file}.backup.$(date +%s)"
    fi

    # Gera todas as chaves/senhas
    local secret_key
    local encryption_key
    local mariadb_root_password
    local mariadb_password
    local postgres_password

    secret_key=$(openssl rand -hex 32)
    encryption_key=$(gen_encryption_key)
    mariadb_root_password=$(gen_password)
    mariadb_password=$(gen_password)
    postgres_password=$(gen_password)

    log_info "Gerando credenciais seguras..."

    cat > "${env_file}" <<EOF
# =============================================================================
# TorFiles - Configuração gerada automaticamente pelo install.run
# $(date)
# =============================================================================

# Chaves de segurança da aplicação (NÃO PERCA ESTAS CHAVES!)
SECRET_KEY=${secret_key}
ENCRYPTION_KEY=${encryption_key}

# Senhas dos bancos de dados (geradas aleatoriamente)
MARIADB_ROOT_PASSWORD=${mariadb_root_password}
MARIADB_PASSWORD=${mariadb_password}
POSTGRES_PASSWORD=${postgres_password}

# Configurações opcionais
DOCS_ENABLED=true

# =============================================================================
# IMPORTANTE: Guarde este arquivo com segurança!
# - SECRET_KEY: Necessária para sessões Flask (perda = usuários deslogados)
# - ENCRYPTION_KEY: Necessária para descriptografar arquivos (PERDA = DADOS PERDIDOS!)
# - Senhas dos bancos: Para backup/restore manual se necessário
# =============================================================================
EOF

    chmod 600 "${env_file}"
    log_ok "Arquivo .env criado em ${env_file} (permissões 600)"
    log_warn "⚠️  BACKUP OBRIGATÓRIO: Copie este arquivo para local seguro!"
    log_warn "   Perda da ENCRYPTION_KEY = PERDA TOTAL DOS ARQUIVOS CRIPTOGRAFADOS!"

    # Mostra resumo (sem mostrar as chaves completas por segurança)
    echo
    echo "  Credenciais geradas:"
    echo "  ────────────────────────────────────────────────────────────────"
    printf "  SECRET_KEY:           %s...%s\n" "${secret_key:0:8}" "${secret_key: -8}"
    printf "  ENCRYPTION_KEY:       %s...%s\n" "${encryption_key:0:12}" "${encryption_key: -12}"
    printf "  MARIADB_ROOT_PASSWORD: %s\n" "${mariadb_root_password}"
    printf "  MARIADB_PASSWORD:      %s\n" "${mariadb_password}"
    printf "  POSTGRES_PASSWORD:     %s\n" "${postgres_password}"
    echo "  ────────────────────────────────────────────────────────────────"
}

# Build da imagem Docker
build_docker_image() {
    local project_dir="$1"

    log_step "Construindo imagem Docker do TorFiles"

    cd "${project_dir}"

    log_info "Executando docker build..."
    docker build -t torfiles:latest .

    log_ok "Imagem torfiles:latest criada com sucesso"
}

# Sobe os containers
start_containers() {
    local project_dir="$1"

    log_step "Iniciando containers"

    cd "${project_dir}"

    log_info "Subindo stack com ${COMPOSE_CMD}..."
    ${COMPOSE_CMD} up -d

    log_ok "Containers iniciados"

    # Aguarda healthchecks
    log_info "Aguardando health checks dos bancos de dados..."
    local max_wait=120
    local waited=0
    local interval=5

    while [[ ${waited} -lt ${max_wait} ]]; do
        local mariadb_health
        local postgres_health

        mariadb_health=$(docker inspect --format='{{.State.Health.Status}}' torfiles-mariadb 2>/dev/null || echo "unknown")
        postgres_health=$(docker inspect --format='{{.State.Health.Status}}' torfiles-postgres 2>/dev/null || echo "unknown")

        if [[ "${mariadb_health}" == "healthy" && "${postgres_health}" == "healthy" ]]; then
            log_ok "Todos os bancos de dados estão saudáveis"
            break
        fi

        sleep ${interval}
        waited=$((waited + interval))
        echo -n "."
    done
    echo

    if [[ ${waited} -ge ${max_wait} ]]; then
        log_warn "Timeout aguardando health checks. Verifique com: ${COMPOSE_CMD} logs"
    fi
}

# Verifica se a aplicação está respondendo
verify_app() {
    local project_dir="$1"

    log_step "Verificando aplicação"

    cd "${project_dir}"

    local max_wait=60
    local waited=0
    local interval=3

    while [[ ${waited} -lt ${max_wait} ]]; do
        if curl -sf http://localhost:8000 >/dev/null 2>&1; then
            log_ok "Aplicação respondendo em http://localhost:8000"
            return 0
        fi
        sleep ${interval}
        waited=$((waited + interval))
        echo -n "."
    done
    echo

    log_warn "Aplicação pode não estar pronta ainda. Verifique logs com: ${COMPOSE_CMD} logs -f app"
}

# Mostra resumo final
show_summary() {
    local project_dir="$1"

    cat <<EOF

╔══════════════════════════════════════════════════════════════════════════════╗
║                         INSTALAÇÃO CONCLUÍDA!                                ║
╚══════════════════════════════════════════════════════════════════════════════╝

📁 Diretório do projeto: ${project_dir}
🌐 Aplicação: http://localhost:8000
📄 Documentação: http://localhost:8000/docs (se DOCS_ENABLED=true)

📦 Containers:
   • torfiles-web      - Aplicação Flask (porta 8000)
   • torfiles-mariadb  - MariaDB (metadados/usuários)
   • torfiles-postgres - PostgreSQL (arquivos criptografados)

🔧 Comandos úteis:
   Ver logs:                ${COMPOSE_CMD} logs -f
   Ver logs app:            ${COMPOSE_CMD} logs -f app
   Parar tudo:              ${COMPOSE_CMD} down
   Parar + remover volumes: ${COMPOSE_CMD} down -v  ⚠️ APAGA DADOS!
   Reiniciar:               ${COMPOSE_CMD} restart
   Atualizar app:           cd ${project_dir} && docker build -t torfiles:latest . && ${COMPOSE_CMD} up -d

⚠️  BACKUP CRÍTICO - GUARDE ESTES ARQUIVOS EM LOCAL SEGURO:
   ${project_dir}/.env  (contém TODAS as chaves e senhas)

   PERDA DA ENCRYPTION_KEY == PERDA TOTAL E IRREVERSÍVEL DOS ARQUIVOS!

📖 Próximos passos recomendados:
   1. Faça backup do arquivo .env EM LOCAL SEGURO
   2. Configure proxy reverso (Nginx) + HTTPS (Certbot) para produção
   3. Para Tor Hidden Service: veja docs/deployment.md
   4. Configure backups automáticos dos bancos (MariaDB + PostgreSQL)

EOF
}

# Função principal
main() {
    show_banner
    check_root
    detect_distro

    sleep 100

    # Diretório do projeto (onde está o script)
    local script_dir
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

    # Verifica se estamos no diretório do projeto (tem Dockerfile, docker-compose.yml)
    if [[ ! -f "${script_dir}/Dockerfile" ]] || [[ ! -f "${script_dir}/docker-compose.yml" ]]; then
        log_err "Execute este script a partir do diretório raiz do projeto TorFiles"
        log_err "Arquivos necessários: Dockerfile, docker-compose.yml"
        exit 1
    fi

    log_step "Iniciando instalação do TorFiles"

    update_package_cache
    install_docker
    ensure_docker_compose
    prepare_env_file "${script_dir}"
    build_docker_image "${script_dir}"
    start_containers "${script_dir}"
    verify_app "${script_dir}"
    show_summary "${script_dir}"

    log_ok "Instalação finalizada com sucesso!"
}

# Executa
main "$@"